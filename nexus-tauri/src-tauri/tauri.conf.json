{
  "productName": "NEXUS",
  "version": "0.1.0",
  "identifier": "ai.nexus.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Encrypted file sharing with p2p networking",
    "longDescription": "NEXUS: A peer-to-peer encrypted file sharing application using libp2p for NAT traversal, Proxy Re-Encryption for secure sharing, and content-addressed storage for integrity.",
    "fileAssociations": [
      {
        "ext": ["nexus-bundle"],
        "mimeType": "application/x-nexus-bundle",
        "description": "NEXUS Encrypted Bundle"
      }
    ],
    "linux": {
      "deb": {
        "depends": ["libssl3", "libwebkit2gtk-4.1-0"],
        "section": "net"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": null,
      "exceptionDomain": ""
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NEXUS",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
